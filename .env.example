# UBEK Next — Environment Variables
# Copy this file to .env and fill in the values.
# Generate secrets: openssl rand -hex 32

# ─── Next.js (Frontend :3000) ────────────────────────────
JWT_SECRET=replace-with-openssl-rand-hex-32
AGENT_API_KEY=replace-with-openssl-rand-hex-32
NEXT_PUBLIC_API_URL=http://localhost:3000

# ─── Pi Agent (Backend :4000) ────────────────────────────
PORT=4000

# ─── PostgreSQL ──────────────────────────────────────────
PGHOST=localhost
PGPORT=5433
PGDATABASE=ubek_next
PGUSER=ubek
PGPASSWORD=ubek

# ─── Router LLM (localhost:18881) ────────────────────────
ROUTER_URL=http://localhost:18881/v1
ROUTER_API_KEY=sk-rtr-replace-with-real-key
MODEL=default

# ─── Vault ──────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600
